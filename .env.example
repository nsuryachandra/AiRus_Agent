# ============================================================
# AiRus Environment Configuration Template
# COPY this file to .env or server/.env and fill in real values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# Node Server Environment
NODE_ENV=development
PORT=5000

# Client origin (CORS allowed origin for backend)
# For local development: http://localhost:5173
# For Render deployment: https://airus-frontend.onrender.com (or your custom domain)
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
# Generate a strong 64-character secret for production: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# NVIDIA API Configuration (Server-side ONLY - Never expose to frontend)
# Obtain from NVIDIA NGC / build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default fast & capable model
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Local example: postgresql://postgres:postgres@localhost:5432/airus
# Remote Render / Supabase / Neon example: postgresql://airus_user:secret@dpg-xxx.render.com/airus_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airus

# Optional: Set to 'true' if running local tests or dev without a live Postgres instance
# Uses in-memory persistent adapter for mock testing when Postgres is not available
USE_DEV_FALLBACK_DB=false
